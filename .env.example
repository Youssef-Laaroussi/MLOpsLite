# ==============================================================================
# MLite (MLOpsLite) Environment Configuration Template
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# Project
PROJECT_NAME=mlite
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=mlite_user
POSTGRES_PASSWORD=mlite_secure_password
POSTGRES_DB=mlite_db
POSTGRES_MULTIPLE_DATABASES=mlite_db,mlflow_db
POSTGRES_HOST=mlite-db
DB_PORT=5432

# SQLAlchemy Async Connection Strings
DATABASE_URL=postgresql+asyncpg://mlite_user:mlite_secure_password@mlite-db:5432/mlite_db
MLFLOW_DATABASE_URL=postgresql://mlite_user:mlite_secure_password@mlite-db:5432/mlflow_db

# ------------------------------------------------------------------------------
# MinIO S3-Compatible Object Storage
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=mlite_minio_admin
MINIO_ROOT_PASSWORD=mlite_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://mlite-storage:9000
MINIO_DATASETS_BUCKET=mlite-datasets
MINIO_MLFLOW_BUCKET=mlflow-artifacts
MINIO_EVALUATIONS_BUCKET=mlite-evaluations

# S3 Client Compatibility (Used by MLflow, DVC, and Boto3)
AWS_ACCESS_KEY_ID=mlite_minio_admin
AWS_SECRET_ACCESS_KEY=mlite_minio_password
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://mlite-storage:9000
MLFLOW_S3_IGNORE_TLS=true

# ------------------------------------------------------------------------------
# MLflow Tracking Server
# ------------------------------------------------------------------------------
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# ------------------------------------------------------------------------------
# MLite Backend REST API (FastAPI)
# ------------------------------------------------------------------------------
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=2
API_RELOAD=true
API_V1_STR=/api/v1
SECRET_KEY=mlite_dev_secret_key_change_in_production_32bytes!
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# MLite Frontend Dashboard (React 18 + Vite)
# ------------------------------------------------------------------------------
UI_PORT=3000
VITE_API_BASE_URL=http://localhost:8000
